<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.anchor.agent">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wake up exactly when a timer or schedule starts or ends. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- "Instagram is blocked" notices when a never-allowed app gets installed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Remove Anchor's own placeholder apps when a never-allowed app is released, and uninstall a
         blocked app when the user asks for it on the computer. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- See every installed app (Android 11+ package visibility). Needed to keep track of apps
         Anchor hides (hidden apps lose their launcher entry) and to notice never-allowed installs. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Lets the agent list every app that has a launcher icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AnchorApp"
        android:label="Anchor"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Command channel for the desktop app. Only adb (shell/root uid) may call it;
             every state-changing command also needs the computer's key. -->
        <provider
            android:name=".CommandProvider"
            android:authorities="app.anchor.agent.cmd"
            android:exported="true" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ReapplyJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
